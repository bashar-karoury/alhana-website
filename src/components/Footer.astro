---
import type { Lang } from '../data/site';
import { site } from '../data/site';
import { categories } from '../data/categories';
import { useT, path } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const year = new Date().getFullYear();
---

<footer class="border-t-4 border-teal bg-white">
  <div class="container-site flex flex-col gap-10 py-14">
    <div class="flex flex-col justify-between gap-10 lg:flex-row lg:items-start">
      <img src="/logo.svg" alt={site.name[lang]} width="167" height="72" loading="lazy" class="h-[72px] w-auto self-start" />
      <div class="grid grid-cols-1 gap-10 text-[15px] sm:grid-cols-3 sm:gap-16">
        <div class="flex flex-col gap-2.5">
          <h2 class="eyebrow text-[13px] text-subtle">{t('nav.machines')}</h2>
          {
            categories.map((c) => (
              <a href={path(lang, 'machines', c.slug)} class="text-ink no-underline hover:text-teal-dark">
                {c.name[lang]}
              </a>
            ))
          }
        </div>
        <div class="flex flex-col gap-2.5">
          <h2 class="eyebrow text-[13px] text-subtle">{t('footer.company')}</h2>
          <a href={path(lang) + '#about'} class="text-ink no-underline">{t('nav.about')}</a>
          <a href={path(lang, 'parts-maintenance')} class="text-ink no-underline">{t('nav.parts')}</a>
          <a href={path(lang, 'contact')} class="text-ink no-underline">{t('nav.contact')}</a>
        </div>
        <div class="flex flex-col gap-2.5">
          <h2 class="eyebrow text-[13px] text-subtle">{t('footer.reach')}</h2>
          <a href={site.phoneHref} class="text-ink no-underline rtl:text-right" dir="ltr">{site.phone}</a>
          <a href={`mailto:${site.email}`} class="text-ink no-underline">{site.email}</a>
        </div>
      </div>
    </div>
    <div class="flex flex-col justify-between gap-2 border-t border-line-2 pt-6 text-sm text-subtle sm:flex-row">
      <p>© {year} {site.name[lang]}. {t('footer.rights')}</p>
      <p>{t('footer.specs')}</p>
    </div>
  </div>
</footer>
