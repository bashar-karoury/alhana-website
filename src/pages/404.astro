---
import '../styles/global.css';
import { site } from '../data/site';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Page not found | {site.name.en}</title>
  </head>
  <body>
    <main class="container-site flex min-h-screen flex-col items-start justify-center gap-6 py-20">
      <h1 class="display text-5xl">Page not found</h1>
      <p class="text-lg text-muted">The page you are looking for does not exist.</p>
      <p class="text-lg text-muted" lang="ar" dir="rtl">الصفحة التي تبحث عنها غير موجودة.</p>
      <div class="flex gap-4">
        <a href="/en/" class="btn btn-dark">Home</a>
        <a href="/ar/" class="btn btn-outline" lang="ar">الرئيسية</a>
      </div>
    </main>
  </body>
</html>
